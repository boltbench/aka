---
source: src/shells.rs
expression: "render_for(Shell::Bash)"
---
# Generated by aka X.Y.Z. Don't edit this file, it's rewritten on every change.
# Use `aka add`, `aka edit` or `aka rm` instead.

for __aka_n in ${__AKA_ALIASES-}; do unalias "$__aka_n" 2>/dev/null; complete -r "$__aka_n" 2>/dev/null; done
for __aka_n in ${__AKA_FUNCS-}; do unset -f "$__aka_n" 2>/dev/null; complete -r "$__aka_n" 2>/dev/null; done
unset __aka_n
__AKA_ALIASES='g gs ll ls say'
__AKA_FUNCS='clean mkcd'

alias g='git'
alias gs='git status'
alias ll='ls -la'
alias ls='ls -G'
alias say='echo '\''it'\'''\''s'\'''
unalias clean 2>/dev/null
function clean {
  printf '%s' 'aka: run `rm -rf build`? [y/N] ' >&2
  local __aka_r
  read -r __aka_r
  case "$__aka_r" in [yY]|[yY][eE][sS]) ;; *) return 1 ;; esac
  rm -rf build "$@"
}
unalias mkcd 2>/dev/null
function mkcd {
  mkdir -p "$1" && cd "$1"
}

function aka {
  command aka "$@"
  local __aka_rc=$?
  if [ -f '/home/me/.config/aka/init.bash' ]; then . '/home/me/.config/aka/init.bash'; fi
  return $__aka_rc
}

if [[ $- == *i* ]]; then
_clap_complete_aka() {
    local IFS=$'\013'
    local _CLAP_COMPLETE_INDEX=${COMP_CWORD}
    local _CLAP_COMPLETE_COMP_TYPE=${COMP_TYPE}
    if compopt +o nospace 2> /dev/null; then
        local _CLAP_COMPLETE_SPACE=false
    else
        local _CLAP_COMPLETE_SPACE=true
    fi
    local words=("${COMP_WORDS[@]}")
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        words[COMP_CWORD]="$2"
    fi
    COMPREPLY=( $( \
        _CLAP_IFS="$IFS" \
        _CLAP_COMPLETE_INDEX="$_CLAP_COMPLETE_INDEX" \
        _CLAP_COMPLETE_COMP_TYPE="$_CLAP_COMPLETE_COMP_TYPE" \
        _CLAP_COMPLETE_SPACE="$_CLAP_COMPLETE_SPACE" \
        AKA_COMPLETE="bash" \
        "/usr/local/bin/aka" -- "${words[@]}" \
    ) )
    if [[ $? != 0 ]]; then
        unset COMPREPLY
    elif [[ $_CLAP_COMPLETE_SPACE == false ]] && [[ "${COMPREPLY-}" =~ [=/:]$ ]]; then
        compopt -o nospace
    fi
}
if [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 4 || "${BASH_VERSINFO[0]}" -gt 4 ]]; then
    complete -o nospace -o bashdefault -o nosort -F _clap_complete_aka aka
else
    complete -o nospace -o bashdefault -F _clap_complete_aka aka
fi

__aka_expand() {
  case "$1" in
    clean) __aka_reply='rm -rf build' ;;
    g) __aka_reply='git' ;;
    gs) __aka_reply='git status' ;;
    ll) __aka_reply='ls -la' ;;
    ls) __aka_reply='ls -G' ;;
    mkcd) __aka_reply='mkdir -p "$1" && cd "$1"' ;;
    say) __aka_reply='echo '\''it'\'''\''s'\''' ;;
  esac
}
__aka_complete_alias() {
  local __aka_reply=''
  __aka_expand "$1"
  [ -n "$__aka_reply" ] || return 0
  local -a __aka_words
  read -r -a __aka_words <<< "$__aka_reply"
  local __aka_cmd=${__aka_words[0]}
  local __aka_spec
  __aka_spec=$(complete -p "$__aka_cmd" 2>/dev/null)
  if [ -z "$__aka_spec" ]; then
    if declare -F _comp_complete_load >/dev/null 2>&1; then
      _comp_complete_load "$__aka_cmd" >/dev/null 2>&1
    elif declare -F _completion_loader >/dev/null 2>&1; then
      _completion_loader "$__aka_cmd" >/dev/null 2>&1
    fi
    __aka_spec=$(complete -p "$__aka_cmd" 2>/dev/null)
  fi
  local __aka_re='-F ([^ ]+)'
  [[ $__aka_spec =~ $__aka_re ]] || return 0
  local __aka_fn=${BASH_REMATCH[1]}
  [ "$__aka_fn" = __aka_complete_alias ] && [ "$__aka_cmd" = "$1" ] && return 0
  COMP_LINE="$__aka_reply${COMP_LINE#"$1"}"
  COMP_POINT=$((COMP_POINT + ${#__aka_reply} - ${#1}))
  COMP_WORDS=("${__aka_words[@]}" "${COMP_WORDS[@]:1}")
  COMP_CWORD=$((COMP_CWORD + ${#__aka_words[@]} - 1))
  "$__aka_fn" "$__aka_cmd" "${COMP_WORDS[COMP_CWORD]}" "${COMP_WORDS[COMP_CWORD-1]}"
}
complete -o bashdefault -o default -F __aka_complete_alias clean g gs ll mkcd say
fi
