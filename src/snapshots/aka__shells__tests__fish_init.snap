---
source: src/shells.rs
expression: "render_for(Shell::Fish)"
---
# Generated by aka X.Y.Z. Don't edit this file, it's rewritten on every change.
# Use `aka add`, `aka edit` or `aka rm` instead.

for __aka_n in $__AKA_FUNCS
    functions --erase -- $__aka_n
end
set --erase __aka_n
set --global __AKA_FUNCS 'clean' 'fsh' 'g' 'gs' 'll' 'ls' 'say'

function clean --wraps 'rm -rf build' --description 'rm -rf build'
    read --prompt-str 'aka: run `rm -rf build`? [y/N] ' --local __aka_r
    or return 1
    if not string match --quiet --ignore-case --regex '^(y|yes)$' -- $__aka_r
        return 1
    end
    rm -rf build $argv
end
function fsh --wraps 'echo fish' --description 'echo fish'
    echo fish $argv
end
function g --wraps 'git' --description 'git'
    git $argv
end
function gs --wraps 'git status' --description 'quick status'
    git status $argv
end
function ll --wraps 'ls -la' --description 'ls -la'
    ls -la $argv
end
function ls --description 'ls -G'
    command ls -G $argv
end
function say --wraps 'echo \'it\'\'s\'' --description 'echo \'it\'\'s\''
    echo 'it''s' $argv
end

function aka --description 'Manage your shell aliases'
    command aka $argv
    set --local __aka_rc $status
    if test -f '/home/me/.config/aka/init.fish'
        source '/home/me/.config/aka/init.fish'
    end
    return $__aka_rc
end

if status is-interactive
    complete --erase --command aka
    complete --keep-order --exclusive --command aka --arguments "(AKA_COMPLETE=fish /usr/local/bin/aka -- (commandline --current-process --tokenize --cut-at-cursor) (commandline --current-token))"
end
