---
source: src/shells.rs
expression: "render_for(Shell::Zsh)"
---
# Generated by aka X.Y.Z. Don't edit this file, it's rewritten on every change.
# Use `aka add`, `aka edit` or `aka rm` instead.

for __aka_n in ${=__AKA_ALIASES-}; do unalias "$__aka_n" 2>/dev/null; done
for __aka_n in ${=__AKA_FUNCS-}; do unfunction "$__aka_n" 2>/dev/null; done
unset __aka_n
__AKA_ALIASES='g gs ll ls say'
__AKA_FUNCS='clean mkcd'

alias g='git'
alias gs='git status'
alias ll='ls -la'
alias ls='ls -G'
alias say='echo '\''it'\'''\''s'\'''
unalias clean 2>/dev/null
function clean {
  printf '%s' 'aka: run `rm -rf build`? [y/N] ' >&2
  local __aka_r
  read -r __aka_r
  case "$__aka_r" in [yY]|[yY][eE][sS]) ;; *) return 1 ;; esac
  rm -rf build "$@"
}
unalias mkcd 2>/dev/null
function mkcd {
  mkdir -p "$1" && cd "$1"
}

function aka {
  command aka "$@"
  local __aka_rc=$?
  if [[ -f '/home/me/.config/aka/init.zsh' ]]; then source '/home/me/.config/aka/init.zsh'; fi
  return $__aka_rc
}

if [[ -o interactive ]] && (( $+functions[compdef] )); then
#compdef aka
function _clap_dynamic_completer_aka() {
    local _CLAP_COMPLETE_INDEX=$(expr $CURRENT - 1)
    local _CLAP_IFS=$'\n'

    local completions=("${(@f)$( \
        _CLAP_IFS="$_CLAP_IFS" \
        _CLAP_COMPLETE_INDEX="$_CLAP_COMPLETE_INDEX" \
        AKA_COMPLETE="zsh" \
        /usr/local/bin/aka -- "${words[@]}" 2>/dev/null \
    )}")

    if [[ -n $completions ]]; then
        local -a dirs=()
        local -a other=()
        local completion
        for completion in $completions; do
            local value="${completion%%:*}"
            if [[ "$value" == */ ]]; then
                local dir_no_slash="${value%/}"
                if [[ "$completion" == *:* ]]; then
                    local desc="${completion#*:}"
                    dirs+=("$dir_no_slash:$desc")
                else
                    dirs+=("$dir_no_slash")
                fi
            else
                other+=("$completion")
            fi
        done
        [[ -n $dirs ]] && _describe -V 'values' dirs -S '/' -r '/'
        [[ -n $other ]] && _describe -V 'values' other
    fi
}

compdef _clap_dynamic_completer_aka aka
compdef clean=rm
compdef mkcd=mkdir
__aka_descs=('clean:rm -rf build' 'g:git' 'gs:quick status' 'll:ls -la' 'ls:ls -G' 'mkcd:mkdir -p "$1" && cd "$1"' 'say:echo '\''it'\'''\''s'\''')
if [[ ${_comps[-command-]} != _aka_command ]]; then
  __aka_command_prev=${_comps[-command-]:-_command_names}
fi
_aka_command() {
  (( ${#__aka_descs} )) && _describe -t aka-aliases 'aka alias' __aka_descs
  "$__aka_command_prev" "$@"
}
compdef _aka_command -command-
# aka's aliases already appear above with descriptions; don't list them twice.
zstyle ':completion:*:-command-:*:aliases' ignored-patterns ${=__AKA_ALIASES}
fi
